{
  "name": "@cursor/sdk",
  "version": "1.0.37",
  "description": "TypeScript SDK for Cursor agents.",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/cursor/cursor"
  },
  "homepage": "https://cursor.com",
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist/**/*",
    "LICENSE.md",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "bun": "./dist/bundled/index.js",
      "anysphere-source": "./src/index.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./agent": {
      "bun": "./dist/bundled/index.js",
      "anysphere-source": "./src/index.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./sqlite": {
      "bun": "./dist/bundled/sqlite.js",
      "anysphere-source": "./src/sqlite.ts",
      "require": "./dist/cjs/sqlite.js",
      "import": "./dist/esm/sqlite.js",
      "default": "./dist/esm/sqlite.js"
    },
    "./bundled": {
      "anysphere-source": "./src/bundled.ts",
      "bun": "./dist/bundled/index.js",
      "default": "./dist/bundled/index.js"
    },
    "./bundled/sqlite": {
      "anysphere-source": "./src/bundled/sqlite.ts",
      "bun": "./dist/bundled/sqlite.js",
      "default": "./dist/bundled/sqlite.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@bufbuild/protobuf": "1.10.0",
    "@connectrpc/connect": "^1.6.1",
    "@connectrpc/connect-web": "^1.6.1",
    "@statsig/js-client": "3.31.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "1.10.0",
    "@connectrpc/connect": "^1.6.1",
    "@connectrpc/connect-node": "^1.6.1",
    "@connectrpc/connect-web": "^1.6.1",
    "@types/node": "^22.5.5",
    "oxfmt": "0.66.0",
    "ts-loader": "9.5.7",
    "tsx": "^4.20.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^6.0.0",
    "vitest": "^4.0.18",
    "webpack": "^5.98.0",
    "zod": "^3.25.0",
    "@anysphere/agent-client": "1.0.0",
    "@anysphere/agent-exec": "1.0.0",
    "@anysphere/agent-core": "1.0.0",
    "@anysphere/agent-pr-attribution": "1.0.0",
    "@anysphere/analytics-client": "1.0.0",
    "@anysphere/agent-kv": "1.0.0",
    "@anysphere/analytics-types": "1.0.0",
    "@anysphere/cursor-sdk-local-runtime": "1.0.0",
    "@anysphere/bidi-connect": "1.0.0",
    "@anysphere/cursor-sdk-shared": "1.0.0",
    "@anysphere/cursor-plugins": "1.0.0",
    "@anysphere/context": "1.0.0",
    "@anysphere/context-rpc": "0.1.0",
    "@anysphere/dune-atomic-write": "0.0.1",
    "@anysphere/git-core": "1.0.0",
    "@anysphere/hooks": "1.0.0",
    "@anysphere/local-exec": "1.0.0",
    "@anysphere/mcp-agent-exec": "1.0.0",
    "@anysphere/shell-exec": "1.0.0",
    "@anysphere/proto": "1.0.0",
    "@anysphere/utils": "1.0.0"
  },
  "optionalDependencies": {
    "@cursor/sdk-darwin-arm64": "1.0.37",
    "@cursor/sdk-darwin-x64": "1.0.37",
    "@cursor/sdk-linux-arm64": "1.0.37",
    "@cursor/sdk-linux-x64": "1.0.37",
    "@cursor/sdk-win32-x64": "1.0.37"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "echo noop",
    "build:internal": "node --import tsx scripts/build-agent.ts --mode dev",
    "build:bundled": "bun scripts/build-flat-bundle.ts",
    "prepare:rg": "node scripts/download-rg.js",
    "fetch:sandbox-helper-artifacts": "node scripts/fetch-sandbox-helper-artifacts.cjs",
    "stage:sandbox-helper": "node scripts/stage-sandbox-helper.cjs",
    "stage:tree-sitter": "node scripts/stage-tree-sitter-runtime.cjs",
    "generate-platform-packages": "node --import tsx scripts/generate-platform-packages.ts",
    "build:prod": "pnpm prepare:rg && node --import tsx scripts/build-agent.ts --mode prod && pnpm build:bundled && pnpm stage:sandbox-helper && pnpm stage:tree-sitter && pnpm generate-platform-packages",
    "build:local": "scripts/build-local.sh",
    "build:publish": "scripts/build.sh",
    "smoke:publish-artifact": "node publish-checks/smoke-publish-artifact.cjs",
    "publish:built": "scripts/publish.sh",
    "check": "oxlint src && tsc -p tsconfig.json --noEmit",
    "fix": "oxlint --fix src && oxfmt --write --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "prettier:changed": "git diff -z --name-only --diff-filter=ACMRTUXB --relative HEAD -- . | xargs -0 oxfmt --write --no-error-on-unmatched-pattern",
    "prettier:branch": "UPSTREAM=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main); BASE=$(git merge-base HEAD \"$UPSTREAM\"); git diff -z --name-only --diff-filter=ACMRTUXB --relative \"$BASE\" -- . | xargs -0 -n1 -I{} oxfmt --write --no-error-on-unmatched-pattern \"{}\"",
    "build-schemas": "tsc -b tsconfig.schemas.json --force",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "build-types": "tsc -b tsconfig.dts.schemas.json --force && tsc -p tsconfig.dts.json",
    "publish-checks": "vitest run --config vitest.publish-checks.config.ts"
  }
}